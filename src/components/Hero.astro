---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white py-24 md:h-screen"
>
  <!-- Background -->
  <div class="absolute inset-0 -z-10 bg-gray-50"></div>

  <div class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center">
    
    <!-- Text + Emoji Container -->
    <div class="flex items-center gap-16 w-full">

      <!-- Text Section -->
      <div>

        <!-- Hi I'm -->
        <h2
          class="text-2xl sm:text-3xl md:text-4xl text-gray-700 animate-fade-in"
          style="font-family:'Times New Roman', Times, serif;"
        >
          Hi, I'm
        </h2>

        <!-- Name -->
        <h1
          class="mt-4 text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-black animate-fade-in animation-delay-200"
          style="font-family:'Times New Roman', Times, serif;"
        >
          B R NEHA
        </h1>

        <!-- Project Title -->
        <p
          class="mt-8 text-lg sm:text-xl md:text-2xl text-gray-600 animate-fade-in animation-delay-400"
          style="font-family:'Times New Roman', Times, serif;"
        >
          EMG-Controlled Robotic Hand Assist Device
        </p>

      </div>

      <!-- Emoji Image -->
      <img
       src="/EMG-Controlled-Robotic-Hand-Assist-Device/emoji-hi.png"
       alt="Waving Emoji"
       class="hidden md:block w-[450px] h-auto animate-fade-in animation-delay-400"
      />

    </div>

  </div>

  <!-- Social Icons -->
  <div
    class="hidden"
  >

    {
      siteConfig.social?.email && (
        <a
          href={`mailto:nehnehaaz@gmail.com`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-blue-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }

    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-blue-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M8 11v5" />
            <path d="M8 8v.01" />
            <path d="M12 16v-5" />
            <path d="M16 16v-3a2 2 0 1 0 -4 0" />
            <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
          </svg>
        </a>
      )
    }

    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-blue-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
          </svg>
        </a>
      )
    }

  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
</style>